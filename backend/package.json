{
  "name": "ems-backend",
  "version": "1.0.0",
  "description": "Production-grade Event Management System Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "moduleNameMapper": {
      "^ioredis$": "<rootDir>/test/mocks/ioredis.js",
      "^bullmq$": "<rootDir>/test/mocks/bullmq.js"
    },
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/utils/webhookSignature.js",
      "src/utils/secretVault.js",
      "src/utils/urlGuard.js",
      "src/utils/AppError.js",
      "src/middleware/errorHandler.js",
      "src/services/webhookService.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 60,
        "branches": 55
      }
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.28.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nock": "^13.5.6",
    "supertest": "^7.3.1"
  }
}
